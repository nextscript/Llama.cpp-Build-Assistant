# Python
__pycache__/
*.py[cod]
*.egg-info/

# Project virtualenv (created by python_manager.py)
.venv/
.python-interpreter

# Build outputs and toolchain downloads
build/
dist/
build_assets/
Llama.cpp-Build-Assistant-*.spec
builds/
